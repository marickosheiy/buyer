      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define=ENABLE_BUYER_BACKEND=true",
        "--dart-define=API_BASE_URL=http://127.0.0.1:8000/api"
      ]
    },
    {
      "name": "Lumear · Local sample preview",
